rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- BASIC AUTH HELPERS ----------
    function signedIn() {
      return request.auth != null;
    }

    function staffDoc() {
      return get(/databases/$(database)/documents/staff/$(request.auth.uid));
    }

    // Pharmacist/admin accounts are controlled by the staff collection.
    // This deliberately does NOT depend on /users, so the pharmacist portal
    // can authenticate and load its staff profile independently.
    function isChatStaff() {
      return signedIn()
        && exists(/databases/$(database)/documents/staff/$(request.auth.uid))
        && staffDoc().data.role in ['pharmacist', 'admin']
        && staffDoc().data.active != false;
    }

    function isAdmin() {
      return isChatStaff()
        && staffDoc().data.role == 'admin';
    }

    function ownsConversation(conversationId) {
      return signedIn()
        && exists(/databases/$(database)/documents/conversations/$(conversationId))
        && get(/databases/$(database)/documents/conversations/$(conversationId)).data.customerUid == request.auth.uid;
    }

    // ---------- CUSTOMER ACCOUNTS ----------
    match /users/{userId} {
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.role == 'customer'
        && request.resource.data.active == true;

      allow read: if signedIn() && request.auth.uid == userId;
      allow read: if isChatStaff();

      allow update: if isChatStaff();
      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.role == resource.data.role
        && request.resource.data.active == resource.data.active;

      allow delete: if isAdmin();
    }

    // ---------- PHARMACY STORE ----------
    match /products/{productId} {
      allow read: if resource.data.active == true || isChatStaff();
      allow create, update, delete: if isChatStaff();
    }

    match /categories/{categoryId} {
      allow read: if resource.data.active == true || isChatStaff();
      allow create, update, delete: if isChatStaff();
    }

    match /orders/{orderId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.orderStatus == 'pending'
        && request.resource.data.paymentStatus == 'pending';

      allow read: if isChatStaff()
        || (signedIn() && resource.data.userId == request.auth.uid);

      allow update: if isChatStaff();
      allow delete: if isAdmin();
    }

    match /inventory/{productId} {
      allow read, create, update, delete: if isChatStaff();
    }

    match /promotions/{promotionId} {
      allow read: if resource.data.active == true || isChatStaff();
      allow create, update, delete: if isChatStaff();
    }

    match /website/{pageId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ---------- PHARMACIST PORTAL ----------
    // A signed-in pharmacist can always read their own staff profile.
    // This is important because staffLogin() reads staff/{auth.uid}
    // immediately after Firebase Authentication succeeds.
    match /staff/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow read: if isChatStaff();
      allow create, update, delete: if false;
    }

    // ---------- LIVE PHARMACIST CHAT ----------
    match /conversations/{conversationId} {

      // Customers may start a fresh website conversation.
      allow create: if signedIn()
        && request.resource.data.customerUid == request.auth.uid
        && request.resource.data.status == 'waiting'
        && request.resource.data.channel == 'website'
        && request.resource.data.privacyConsent == true;

      // Pharmacists/admins can see the queues; customers can see their own chat.
      allow read: if isChatStaff() || ownsConversation(conversationId);

      // Pharmacists/admins may update conversation state.
      allow update: if isChatStaff();

      // Customers may only close/reopen their own conversation using the
      // fields required by the website client. They cannot assign staff,
      // change ownership, or alter other conversation metadata.
      allow update: if ownsConversation(conversationId)
        && request.resource.data.customerUid == resource.data.customerUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'updatedAt',
          'lastMessageAt',
          'closedByCustomer',
          'closedAt'
        ])
        && (
          request.resource.data.status in ['waiting', 'active']
          || (
            request.resource.data.status == 'closed'
            && request.resource.data.closedByCustomer == true
          )
        );

      allow delete: if false;

      // ---------- CHAT MESSAGES ----------
      match /messages/{messageId} {
        // Both sides can read the conversation messages.
        allow read: if isChatStaff() || ownsConversation(conversationId);

        // Pharmacists/admins can send staff messages. Customers can only
        // create messages identifying themselves as the authenticated user.
        allow create: if isChatStaff()
          || (
            ownsConversation(conversationId)
            && request.resource.data.senderUid == request.auth.uid
            && request.resource.data.senderType == 'customer'
          );

        allow update, delete: if false;
      }
    }
  }
}
