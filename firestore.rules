rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userProfile() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      );
    }

    function isActiveUser() {
      return signedIn()
        && userProfile().data.active != false;
    }

    function isStaff() {
      return isActiveUser()
        && userProfile().data.role in [
          'staff',
          'admin',
          'superadmin'
        ];
    }

    function isAdmin() {
      return isActiveUser()
        && userProfile().data.role in [
          'admin',
          'superadmin'
        ];
    }

    function chatStaff() {
      return signedIn()
        && exists(/databases/$(database)/documents/staff/$(request.auth.uid))
        && get(
          /databases/$(database)/documents/staff/$(request.auth.uid)
        ).data.role in ['pharmacist', 'admin']
        && get(
          /databases/$(database)/documents/staff/$(request.auth.uid)
        ).data.active != false;
    }

    function mainConversationOwner(conversationId) {
      return signedIn()
        && get(
          /databases/$(database)/documents/main_conversations/$(conversationId)
        ).data.customerUid == request.auth.uid;
    }

    match /users/{userId} {
      allow create:
        if signedIn()
        && request.auth.uid == userId
        && request.resource.data.role == 'customer'
        && request.resource.data.active == true;
      allow read:
        if signedIn() && (request.auth.uid == userId || isStaff());
      allow update:
        if isStaff()
        || (signedIn() && request.auth.uid == userId
          && request.resource.data.role == resource.data.role
          && request.resource.data.active == resource.data.active);
      allow delete: if isAdmin();
    }

    match /products/{productId} {
      allow read: if resource.data.active == true || isStaff();
      allow create, update, delete: if isStaff();
    }

    match /categories/{categoryId} {
      allow read: if resource.data.active == true || isStaff();
      allow create, update, delete: if isStaff();
    }

    match /orders/{orderId} {
      allow create:
        if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.orderStatus == 'pending'
        && request.resource.data.paymentStatus == 'pending';
      allow read: if isStaff() || (signedIn() && resource.data.userId == request.auth.uid);
      allow update: if isStaff();
      allow delete: if isAdmin();
    }

    match /inventory/{productId} {
      allow read, create, update, delete: if isStaff();
    }

    match /promotions/{promotionId} {
      allow read: if resource.data.active == true || isStaff();
      allow create, update, delete: if isStaff();
    }

    match /website/{pageId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /staff/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || chatStaff());
      allow create, update, delete: if false;
    }

    match /main_conversations/{conversationId} {
      allow create:
        if signedIn()
        && request.resource.data.customerUid == request.auth.uid
        && request.resource.data.status == 'waiting'
        && request.resource.data.channel == 'website'
        && request.resource.data.privacyConsent == true;

      allow read: if chatStaff() || mainConversationOwner(conversationId);

      allow update:
        if chatStaff()
        || (
          mainConversationOwner(conversationId)
          && request.resource.data.customerUid == resource.data.customerUid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status',
            'updatedAt',
            'lastMessageAt'
          ])
          && request.resource.data.status in ['waiting', 'active', 'closed']
        );

      allow delete: if false;

      match /messages/{messageId} {
        allow read: if chatStaff() || mainConversationOwner(conversationId);
        allow create:
          if chatStaff()
          || (
            mainConversationOwner(conversationId)
            && request.resource.data.senderUid == request.auth.uid
            && request.resource.data.senderType == 'customer'
          );
        allow update, delete: if false;
      }
    }

    match /conversations/{conversationId} {
      allow create, read, update, delete: if false;
      match /messages/{messageId} {
        allow read, create, update, delete: if false;
      }
    }
  }
}
